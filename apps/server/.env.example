# URL HTTPS mà MCP client sẽ kết nối, phải kết thúc bằng /mcp.
PUBLIC_MCP_URL=https://doctmcp.example.com/mcp

# OIDC issuer khớp chính xác trường `issuer` trong discovery document.
OIDC_ISSUER=https://YOUR_AUTH_DOMAIN/

# Audience của JWT access token; authorization server phải phát đúng audience này.
OIDC_AUDIENCE=https://doctmcp.example.com/mcp

# Cổng public WebSocket/HTTP dùng chung.
BIND_HOST=127.0.0.1
PORT=3000

# Tùy chọn: IP chính xác của TLS reverse proxy khi proxy chạy container/mạng riêng.
# Proxy phải ghi đè X-Forwarded-Proto=https; không dùng CIDR hoặc hostname ở đây.
# TRUSTED_PROXY_ADDRESSES=172.20.0.5

# M6.2: data directory cho SQLite bootstrap/migrations. Trong Coolify mount
# persistent volume ở /data rồi đặt DOCTMCP_DATA_DIR=/data.
# Khi M6.6 chưa hoàn tất, device/credential/pairing runtime vẫn in-memory.
# DOCTMCP_DATA_DIR=/data
