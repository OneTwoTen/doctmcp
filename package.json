{
  "name": "doctmcp",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "bun --cwd apps/server run dev",
    "dev:agent": "bun --cwd apps/agent run dev",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:local": "bun scripts/test-local-mcp.ts",
    "ci": "bun run check && bun run typecheck && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
